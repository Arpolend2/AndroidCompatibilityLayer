[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=ru.androidcompatibilitylayer.appmanager
Exec=/usr/bin/ru.androidcompatibilitylayer.appmanager %u
MimeType=application/vnd.android.package-archive;application/x-apks;application/x-xapk;application/zip;
Name=Android App Manager
Name[ru]=Менеджер приложений Android

[X-Application]
Permissions=Internet;UserDirs;Camera;Sensors;Audio;Bluetooth;Location
OrganizationName=ru.androidcompatibilitylayer
ApplicationName=appmanager
ExecDBus=/usr/bin/ru.androidcompatibilitylayer.appmanager --microg-service
ExportDBusInterfaces=ru.androidcompatibilitylayer.appmanager;ru.androidcompatibilitylayer.appmanager.microg;ru.androidcompatibilitylayer.appmanager.log
Intents=OpenURI
