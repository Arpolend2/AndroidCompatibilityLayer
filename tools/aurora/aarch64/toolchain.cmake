# Passed by build.sh; no host-specific paths are stored in this file.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(AURORA_SYSROOT "" CACHE PATH "Aurora aarch64 target rootfs")
set(AURORA_HOST_TOOLS "" CACHE PATH "Directory with executable x86_64 Qt tools")
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES AURORA_SYSROOT AURORA_HOST_TOOLS)
if(NOT AURORA_SYSROOT OR NOT AURORA_HOST_TOOLS)
    message(FATAL_ERROR "Pass AURORA_SYSROOT and AURORA_HOST_TOOLS (build.sh does this automatically)")
endif()

set(CMAKE_SYSROOT "${AURORA_SYSROOT}")
set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)
set(CMAKE_AR aarch64-linux-gnu-ar CACHE FILEPATH "")
set(CMAKE_RANLIB aarch64-linux-gnu-ranlib CACHE FILEPATH "")
set(CMAKE_STRIP aarch64-linux-gnu-strip CACHE FILEPATH "")
set(CMAKE_OBJCOPY aarch64-linux-gnu-objcopy CACHE FILEPATH "")

set(AURORA_ARCH_FLAGS "-march=armv8-a -O2 -fPIC")
set(CMAKE_C_FLAGS_INIT "${AURORA_ARCH_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${AURORA_ARCH_FLAGS}")
set(AURORA_LIB_DIRS "-L${AURORA_SYSROOT}/lib -L${AURORA_SYSROOT}/usr/lib -Wl,-rpath-link,${AURORA_SYSROOT}/lib -Wl,-rpath-link,${AURORA_SYSROOT}/usr/lib")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${AURORA_LIB_DIRS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${AURORA_LIB_DIRS}")

set(CMAKE_FIND_ROOT_PATH "${AURORA_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

foreach(tool moc rcc lrelease lupdate)
    if(NOT TARGET Qt5::${tool})
        add_executable(Qt5::${tool} IMPORTED GLOBAL)
        set_target_properties(Qt5::${tool} PROPERTIES IMPORTED_LOCATION "${AURORA_HOST_TOOLS}/bin/${tool}")
    endif()
endforeach()
