set(CMAKE_SYSTEM_NAME Linux)
set(AURORA_SYSROOT "" CACHE PATH "Matching Aurora SDK target rootfs")
set(AURORA_HOST_TOOLS "" CACHE PATH "Directory containing runnable host Qt tools")
set(AURORA_CROSS_PREFIX "" CACHE STRING "Absolute compiler prefix including the trailing dash")
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    AURORA_SYSROOT AURORA_HOST_TOOLS AURORA_CROSS_PREFIX)
if(NOT AURORA_SYSROOT OR NOT AURORA_HOST_TOOLS OR NOT AURORA_CROSS_PREFIX)
    message(FATAL_ERROR "Pass AURORA_SYSROOT, AURORA_HOST_TOOLS and AURORA_CROSS_PREFIX")
endif()
set(CMAKE_SYSROOT "${AURORA_SYSROOT}")
set(CMAKE_C_COMPILER "${AURORA_CROSS_PREFIX}gcc")
set(CMAKE_CXX_COMPILER "${AURORA_CROSS_PREFIX}g++")
set(CMAKE_AR "${AURORA_CROSS_PREFIX}ar")
set(CMAKE_RANLIB "${AURORA_CROSS_PREFIX}ranlib")
set(CMAKE_STRIP "${AURORA_CROSS_PREFIX}strip")
set(CMAKE_OBJCOPY "${AURORA_CROSS_PREFIX}objcopy")
if(CMAKE_SYSTEM_PROCESSOR STREQUAL "armv7l")
    set(CMAKE_C_FLAGS_INIT "-march=armv7-a -mfloat-abi=hard -mfpu=vfpv3-d16")
    set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
endif()
set(CMAKE_EXE_LINKER_FLAGS_INIT
    "-Wl,--as-needed -Wl,-rpath-link,${AURORA_SYSROOT}/usr/lib64 -Wl,-rpath-link,${AURORA_SYSROOT}/usr/lib")
set(CMAKE_FIND_ROOT_PATH "${AURORA_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
foreach(tool qmake moc rcc uic lrelease lupdate)
    if(NOT TARGET Qt5::${tool})
        add_executable(Qt5::${tool} IMPORTED GLOBAL)
        set_target_properties(Qt5::${tool} PROPERTIES
            IMPORTED_LOCATION "${AURORA_HOST_TOOLS}/${tool}")
    endif()
endforeach()
