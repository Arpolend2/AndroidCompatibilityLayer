[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=ru.androidcompatibilitylayer.AndroidCompatibilityLayer
Exec=/usr/bin/ru.androidcompatibilitylayer.AndroidCompatibilityLayer %u
MimeType=application/vnd.android.package-archive;application/x-apks;application/x-xapk;application/zip;
Name=Android App Manager
Name[ru]=Менеджер приложений Android

[X-Application]
Permissions=Internet;UserDirs;Camera;Sensors;Audio;Bluetooth;Location
OrganizationName=ru.androidcompatibilitylayer
ApplicationName=AndroidCompatibilityLayer
ExecDBus=/usr/bin/ru.androidcompatibilitylayer.AndroidCompatibilityLayer
ExportDBusInterfaces=ru.androidcompatibilitylayer.AndroidCompatibilityLayer
Intents=OpenURI
