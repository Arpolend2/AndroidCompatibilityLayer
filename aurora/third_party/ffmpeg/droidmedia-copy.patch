+static int queue_input(DroidMediaDecState *s, AVPacket *packet, int64_t pts,
+                       int timeout_ms)
+{
+    DroidMediaCodecData data = { 0 };
+    DroidMediaBufferCallbacks cb = { 0 };
+    DroidMediaInputRef *ref;
+    struct timespec deadline;
+    int ret = 0;
+
+    if (pts > INT64_MAX / 1000 || pts < INT64_MIN / 1000)
+        return AVERROR(EINVAL);
+    ref = av_mallocz(sizeof(*ref));
+    if (!ref)
+        return AVERROR(ENOMEM);
+    ref->packet = av_packet_clone(packet);
+    if (!ref->packet) {
+        av_free(ref);
+        return AVERROR(ENOMEM);
+    }
+    ref->state = s;
+    if (clock_gettime(CLOCK_MONOTONIC, &deadline)) {
+        ret = AVERROR(errno);
+        goto fail;
+    }
+    deadline.tv_sec += timeout_ms / 1000;
+    deadline.tv_nsec += (timeout_ms % 1000) * 1000000L;
+    if (deadline.tv_nsec >= 1000000000L) {
+        deadline.tv_sec++;
+        deadline.tv_nsec -= 1000000000L;
+    }
+    pthread_mutex_lock(&s->lock);
+    s->refs++;
+    while (s->input_inflight >= 5 && !s->error && !s->closing) {
+        ret = pthread_cond_timedwait(&s->cond, &s->lock, &deadline);
+        if (ret)
+            break;
+    }
+    if (ret && !s->error && !s->closing) {
+        s->error = AVERROR(ret);
+        av_log(NULL, AV_LOG_ERROR, ret == ETIMEDOUT ?
+               "ACL codec: droidmedia queue timeout\n" :
+               "ACL codec: droidmedia queue wait failed\n");
+    }
+    if (s->error || s->closing) {
+        ret = s->closing ? AVERROR_EOF : AVERROR_EXTERNAL;
+        pthread_mutex_unlock(&s->lock);
+        state_unref(s);
+        goto fail;
+    }
+    s->input_inflight++;
+    s->queue_calls++;
+    s->refs++;
+    pthread_mutex_unlock(&s->lock);
+
+    data.data.data = ref->packet->data;
+    data.data.size = ref->packet->size;
+    data.ts = pts;
+    data.sync = !!(ref->packet->flags & AV_PKT_FLAG_KEY);
+    cb.data = ref;
+    cb.unref = input_buffer_unref;
+    s->api->queue(s->codec, &data, &cb);
+
+    pthread_mutex_lock(&s->lock);
+    s->queue_calls--;
+    pthread_cond_broadcast(&s->cond);
+    ret = s->closing ? AVERROR_EOF : (s->error ? AVERROR_EXTERNAL : 0);
+    pthread_mutex_unlock(&s->lock);
+    state_unref(s);
+    return ret;
+
+fail:
+    av_packet_free(&ref->packet);
+    av_free(ref);
+    return ret;
+}
