+typedef struct DroidMediaStopJob {
+    DroidMediaDecState *state;
+    pthread_mutex_t lock;
+    pthread_cond_t cond;
+    int done, abandoned;
+} DroidMediaStopJob;
+
+static void free_stop_job(DroidMediaStopJob *job)
+{
+    pthread_cond_destroy(&job->cond);
+    pthread_mutex_destroy(&job->lock);
+    av_free(job);
+}
+
+static void *stop_thread(void *opaque)
+{
+    DroidMediaStopJob *job = opaque;
+    DroidMediaDecState *s = job->state;
+    int abandoned;
+
+    pthread_mutex_lock(&s->lock);
+    while (s->queue_calls || s->data_callbacks)
+        pthread_cond_wait(&s->cond, &s->lock);
+    pthread_mutex_unlock(&s->lock);
+    s->api->stop(s->codec);
+    s->stopped = 1;
+
+    pthread_mutex_lock(&job->lock);
+    job->done = 1;
+    abandoned = job->abandoned;
+    pthread_cond_signal(&job->cond);
+    pthread_mutex_unlock(&job->lock);
+    if (abandoned)
+        free_stop_job(job);
+    return NULL;
+}
+
+static int stop_copy_decoder(DroidMediaDecState *s)
+{
+    DroidMediaStopJob *job = av_mallocz(sizeof(*job));
+    pthread_condattr_t attr;
+    pthread_t thread;
+    struct timespec deadline;
+    int ret;
+
+    if (!job)
+        goto failed;
+    job->state = s;
+    ret = pthread_mutex_init(&job->lock, NULL);
+    if (ret) {
+        av_free(job);
+        goto failed;
+    }
+    ret = pthread_condattr_init(&attr);
+    if (!ret) {
+        ret = pthread_condattr_setclock(&attr, CLOCK_MONOTONIC);
+        if (!ret)
+            ret = pthread_cond_init(&job->cond, &attr);
+        pthread_condattr_destroy(&attr);
+    }
+    if (ret) {
+        pthread_mutex_destroy(&job->lock);
+        av_free(job);
+        goto failed;
+    }
+    if (clock_gettime(CLOCK_MONOTONIC, &deadline)) {
+        free_stop_job(job);
+        goto failed;
+    }
+    deadline.tv_sec += ACL_DROID_STOP_TIMEOUT_MS / 1000;
+    deadline.tv_nsec += (ACL_DROID_STOP_TIMEOUT_MS % 1000) * 1000000L;
+    if (deadline.tv_nsec >= 1000000000L) {
+        deadline.tv_sec++;
+        deadline.tv_nsec -= 1000000000L;
+    }
+    ret = pthread_create(&thread, NULL, stop_thread, job);
+    if (ret) {
+        free_stop_job(job);
+        goto failed;
+    }
+    pthread_mutex_lock(&job->lock);
+    while (!job->done) {
+        ret = pthread_cond_timedwait(&job->cond, &job->lock, &deadline);
+        if (ret)
+            break;
+    }
+    if (!job->done) {
+        job->abandoned = 1;
+        atomic_store(&droidmedia_disabled, 1);
+        pthread_mutex_unlock(&job->lock);
+        pthread_detach(thread);
+        av_log(NULL, AV_LOG_ERROR, "droidmedia stop timed out; disabling hardware decoder for this process\n");
+        return AVERROR_EXTERNAL;
+    }
+    pthread_mutex_unlock(&job->lock);
+    pthread_join(thread, NULL);
+    free_stop_job(job);
+    return 0;
+
+failed:
+    atomic_store(&droidmedia_disabled, 1);
+    av_log(NULL, AV_LOG_ERROR, "cannot start bounded droidmedia stop; disabling hardware decoder for this process\n");
+    return AVERROR_EXTERNAL;
+}
