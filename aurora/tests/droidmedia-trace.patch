 #define DM_COLOR_YV12                 0x32315679
 
+static pthread_mutex_t test_lock = PTHREAD_MUTEX_INITIALIZER;
+static int test_started, test_finished, test_active, test_late, test_eos, test_errors, test_stops, test_stopped;
+
+void av_acl_droidmedia_test_snapshot(int out[8]);
+void av_acl_droidmedia_test_snapshot(int out[8])
+{
+    pthread_mutex_lock(&test_lock);
+    out[0] = test_started; out[1] = test_finished; out[2] = test_active; out[3] = test_late;
+    out[4] = test_eos; out[5] = test_errors; out[6] = test_stops; out[7] = test_stopped;
+    pthread_mutex_unlock(&test_lock);
+}
+
+static void test_callback_begin(const char *name, void *opaque)
+{
+    pthread_mutex_lock(&test_lock);
+    test_started++; test_active++;
+    if (test_stopped) test_late++;
+    if (!strcmp(name, "eos")) test_eos++;
+    if (!strcmp(name, "error")) test_errors++;
+    fprintf(stderr, "DROIDTEST callback-begin %s %p stopped=%d\n", name, opaque, test_stopped);
+    pthread_mutex_unlock(&test_lock);
+}
+
+static void test_callback_end(const char *name, void *opaque)
+{
+    pthread_mutex_lock(&test_lock);
+    test_finished++; test_active--;
+    fprintf(stderr, "DROIDTEST callback-end %s %p\n", name, opaque);
+    pthread_mutex_unlock(&test_lock);
+}
+
+static void test_stop_begin(void *opaque)
+{
+    fprintf(stderr, "DROIDTEST stop-begin %p\n", opaque);
+}
+
+static void test_stop_end(void *opaque)
+{
+    pthread_mutex_lock(&test_lock);
+    test_stops++; test_stopped = 1;
+    fprintf(stderr, "DROIDTEST stop-end %p active=%d\n", opaque, test_active);
+    pthread_mutex_unlock(&test_lock);
+}
+
+static void test_new_start(void)
+{
+    pthread_mutex_lock(&test_lock);
+    test_stopped = 0;
+    pthread_mutex_unlock(&test_lock);
+}
